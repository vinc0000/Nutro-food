# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paddle (5th PSP, alongside Flutterwave/PayUnit/Stripe/Paystack).
# Client-side token — safe to expose in frontend code by design (Paddle Dashboard
# > Developers > Authentication > Client-side token). Powers the Paddle.js overlay
# checkout in src/lib/paddle.ts.
VITE_PADDLE_CLIENT_TOKEN=
# Set to "live" once ready for real charges. Anything else (or unset) uses Paddle's
# sandbox — matches PADDLE_ENV on the paddle-pay Edge Function, keep both in sync.
VITE_PADDLE_ENV=sandbox

# Sentry (error monitoring). Client-side DSN — safe to expose in frontend code
# by design, same as the Paddle client token above. Leave unset to run with
# monitoring off (initSentry() no-ops silently).
VITE_SENTRY_DSN=

# --- The following are Supabase Edge Function secrets, NOT Vite/frontend env vars.
# --- Set them with `supabase secrets set NAME=value`, not in this file.
# PADDLE_API_KEY=            (Paddle Dashboard > Developers > Authentication > API key)
# PADDLE_WEBHOOK_SECRET=     (Paddle Dashboard > Developers > Notifications > your endpoint)
# PADDLE_ENV=sandbox         (or "live")
# PADDLE_PRICE_STARTER_MONTHLY=pri_...
# PADDLE_PRICE_STARTER_ANNUAL=pri_...
# PADDLE_PRICE_PREMIUM_MONTHLY=pri_...
# PADDLE_PRICE_PREMIUM_ANNUAL=pri_...
# PADDLE_PRICE_ENTERPRISE_MONTHLY=pri_...
# PADDLE_PRICE_ENTERPRISE_ANNUAL=pri_...
